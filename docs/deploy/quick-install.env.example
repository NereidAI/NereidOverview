# Non-secret quick-install configuration. Keep this file mode 0600.
# Replace every reserved example.org value before running the installer.

export DEPLOYMENT_ROOT="$HOME/.nereidai-deployment"
export KUBECONFIG="$HOME/.kube/nereidai.kubeconfig"
export KUBECONTEXT="nereidai"
export BASE_DOMAIN="example.org"

# Reuse the actual NFSv4 export prepared by the storage owner.
export NFS_SERVER="nfs.example.org"
export NFS_EXPORT="/srv/nfs/nereidai"
export STORAGE_CLASS="nfs-csi"
export LOCAL_STORAGE_CLASS="local-path"
export INGRESS_CLASS="traefik"
export POD_CIDR="10.42.0.0/16"
export SERVICE_CIDR="10.43.0.0/16"

# Additional host used by edge devices for MQTTS; it is added to Link's SANs.
export LINK_MQTTS_HOST="edge.example.org"
export SPHERE_REPLICAS="1"

# full selects all 23 NF-owned images. cpu-xpu selects the 18 core/CPU/Intel-XPU
# images and excludes only the five AMD/NVIDIA trainer images.
export NF_IMAGE_PROFILE="full"
# Comma-separated: intel-gpu,intel-npu,nvidia,amd. Select only installed hardware.
export HARDWARE_PLUGINS=""

export SUITE_ADMIN_USERNAME="admin"
export SUITE_ADMIN_EMAIL="admin@nereidai.local"
export SUITE_ADMIN_FIRST_NAME="Admin"
export SUITE_ADMIN_LAST_NAME="User"

# Product chart selectors. Leave these unset to follow the suite version
# matrix (deploy/suite-versions.yaml): every non-tag checkout resolves to the
# rolling 0.0.0-dev channel; a checkout exactly on a v* tag resolves to that
# release's pinned product versions. Uncomment a variable only for a reviewed
# per-product exception, which then overrides the matrix default.
# export NEREIDIDENTITY_VERSION="0.0.0-dev"
# export NEREIDSPHERE_VERSION="0.0.0-dev"
# export NEREIDHORIZON_VERSION="0.0.0-dev"
# export PRE_VERSION="0.0.0-dev"
# export NEREIDFORGE_VERSION="0.0.0-dev"
# export NEREIDLINK_VERSION="0.0.0-dev"

# Optional verifier-only full Git commit for a reviewed NF verifier fix. Leave
# unset to use the frozen chart's commit. This never changes chart/image versions.
# export NF_VERIFIER_REF="0123456789abcdef0123456789abcdef01234567"

# External acceptance attestations. Leave no until the named action is complete.
# Each waiting stage explains the evidence required before changing its value.
export SPHERE_SSO_ACCEPTANCE_CONFIRMED="no"
export HORIZON_SETUP_CONFIRMED="no"
export PRE_GATE_CONFIRMED="no"
export NF_GATE_CONFIRMED="no"
export NF_LIVE_ACCEPTANCE_CONFIRMED="no"

# Never add passwords, tokens, access keys, secret keys, bcrypt hashes, or other
# credentials here. The installer retains them in separate private stores.

# Site-local Harbor configuration for harbor-sync.sh (deploy-standards §15.3).
# Copy this file to harbor.env in the same directory and fill in real values.
# harbor.env is git-ignored: the internal hostname and credentials must never
# be committed, so this example keeps every value empty.

# Internal registry hostname without scheme or path (required).
HARBOR_HOST=

# Harbor project used by default derivation and the node mirror rewrite.
HARBOR_PROJECT=nereidai

# Credentials for `harbor-sync.sh login`; leave empty for anonymous read.
HARBOR_USER=
HARBOR_PASS=

# Set true only when Harbor serves a self-signed or internal-CA certificate
# that the copy tool cannot verify through the system trust store.
INSECURE_SKIP_VERIFY=false
